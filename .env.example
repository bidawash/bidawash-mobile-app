# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Values are surfaced to the app via app.config.ts -> expo-constants ->
# src/lib/env.ts.

# Sentry — get a DSN from https://sentry.io once the project exists.
SENTRY_DSN=

# Supabase — populated in Phase 2 once the project is created.
SUPABASE_URL=
SUPABASE_ANON_KEY=
